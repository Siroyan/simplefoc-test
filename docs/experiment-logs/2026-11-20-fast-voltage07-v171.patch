+  if (encoder.edgeControlActive) encoder.edgeVelocity.edge(static_cast<uint32_t>(abiQuality.count),encoder.edgeTimestamp());
+  if (runEdges.active) runEdges.edge(encoder.edgeTimestamp(),abiQuality.count,state);
